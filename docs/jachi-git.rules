# Machine-local Codex rules; install in ~/.codex/rules/jachi-helper.rules.
# User authorized routine commits/pushes of completed, verified project work on 2026-10-19.
# Tool prompts remain intact; scope and exclusions are defined in AGENTS.md.
prefix_rule(
    pattern = ["git", "-C", "C:/Users/user/Documents/ChatGPT/프로젝트/jachi-helper", "add", "--"],
    decision = "allow",
    justification = "User authorized staging reviewed files in jachi-helper."
)
prefix_rule(
    pattern = ["git", "-C", "C:/Users/user/Documents/ChatGPT/프로젝트/jachi-helper", "commit", "-m"],
    decision = "prompt",
    justification = "Standing user approval covers completed, verified jachi-helper changes only; preserve tool approval checks."
)
prefix_rule(
    pattern = ["git", "-C", "C:/Users/user/Documents/ChatGPT/프로젝트/jachi-helper", "push", "--", "https://github.com/seung007/jachi-helper.git", "HEAD:refs/heads/main"],
    decision = "prompt",
    justification = "Standing user approval covers verified jachi-helper commits to this main branch; no force push or private data."
)
